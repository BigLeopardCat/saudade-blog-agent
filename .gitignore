# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv*/

# IDE
.vscode/
.idea/

# Environment variables (contains secrets!)
.env

# Generated audio files
output_audio/

# OS files
Thumbs.db
.DS_Store
# Eval run artifacts（runs/ 留档与 last_run.json 不入 git；baseline_*.json 是受控存档，例外进 git）
# 注：必须忽略内容（dir/*）而非目录本身（dir/），否则 negation 无法放行 baseline 文件
eval/report/*
!eval/report/baseline_*.json

# RAG 调试中间快照（recall_eval 已走 live API，不再使用）
eval/data/
eval/cache/

# 图谱查询产物（vectors.f32 1.4MB，由 scripts/build_word_graph.py 可重生成）
data/word_graph/

# 混合检索的向量索引（cache.f32 数百 KB + manifest/cache 的 json，由
# rag/vector_index.py 按语料增量重建）。与图谱产物同理：可重生成、对本机之外没有意义，
# 且换 embedding 模型就会整库失效 ⇒ 入库只会留一份过期垃圾。
data/rag_vectors/

# 建图任务的本机状态（20261003）：lock / state.json / <ts>.log，全是**运行时**产物
# （见 rag/graph_build.py）。它对站点没有任何价值、只对这台机器有意义，不入库。
# ⚠️ 与**父仓**的 logs/ 不是一回事：那边是站点运维日志（rust/agent/traces，
# logrotate 管轮转）；这份是后台重建任务的临时现场。
logs/

# 改代码前的本地备份（如 graph.py 拆分前的全量副本；内容等价于 git 历史，不进库）
agent/*.bak_*
*.bak_*

# CI 里把父仓（Rust，私有）只读 checkout 到这个路径，给跨语言守卫当期望值来源
# （见 docs/adr/adr-0004-cross-language-guard-in-ci.md）。它是**外部仓库**、不是本仓的一部分：
# 忽略掉，`git status` 与一切按工作区遍历的工具都不会把它当本仓的文件。
_parent/

# golden 草稿（含真实用户文本，绝不入库；只在本机被 REVIEW 与人工挑选用）
eval/drafts/
