# 编辑器约定。
#
# ⚠️ **这里写的是声明，执行者是 `tests/test_style_hygiene.py`**：它按下面这几行扫描
# tracked 的手写文本文件（UTF-8 / LF / 末尾换行 / 不用制表符缩进 / 行尾无空白），并在
# 测试里**同源比对**这些取值（改这里不同步改那边会红）。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

# 生成物例外：`eval/report/*.json` 是 `json.dump` 写出的评测基线快照，原样留档，
# 不带末尾换行，也不该被编辑器修改——字节变了就没法对账。
[eval/report/*.json]
insert_final_newline = false
