# Production systemd EnvironmentFile. Copy only for a new installation, then edit privately.
# Do not source this file as shell code. Login/delegation signing keys belong to Rust only.
LLM_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash

# Match the host assertion key; generate an independent confirmation key.
AGENT_ASSERTION_SECRET=
AGENT_CONFIRM_SECRET=
AGENT_ADMIN_BASE=http://127.0.0.1:3000
# Replace the public origin; it also determines browser navigation destinations.
BLOG_API_BASE=https://example.com/api/public
GRAPH_API_BASE=http://127.0.0.1:3000/api/public

# URL-encode the password. This database belongs exclusively to the Agent.
CHECKPOINT_DSN=postgresql://saudade_agent:REPLACE_PASSWORD@127.0.0.1:5432/saudade_agent
CHECKPOINT_FORBID_DB=saudade_blog
DELEGATION_DIR=/var/lib/saudade-agent/data/delegations
TRACE_DIR=/var/lib/saudade-agent/traces
RAG_VECTOR_DSN=
RAG_VECTOR_COLLECTION=blog-public
BLOG_ROOT=/run/saudade-host

# Match the verified endpoint capacity; start with one process and bounded activity.
AGENT_CONTEXT_TOKENS=128000
AGENT_INPUT_TOKENS=128000
# Additional domain schemas; the full input budget still includes fixed tools/discovery.
AGENT_TOOL_SCHEMA_TOKENS=4096
AGENT_MAX_CONCURRENT=8
AGENT_WORKERS=1
AGENT_PORT=8010
LOG_LEVEL=INFO

# Enable optional services only after installing and verifying their dependencies.
SCHEDULING_ENABLED=false
RAG_HYBRID_ENABLED=false
IOT_ENABLED=false
TTS_ENABLED=false
