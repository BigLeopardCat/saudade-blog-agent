# ═══════════════════════════════════════════════════════════════════
#  Provider selection
# ═══════════════════════════════════════════════════════════════════
# Change LLM_PROVIDER to switch between models without touching
# the other providers' keys.
LLM_PROVIDER=deepseek

# ═══════════════════════════════════════════════════════════════════
#  DeepSeek
# ═══════════════════════════════════════════════════════════════════
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ═══════════════════════════════════════════════════════════════════
#  Qwen (通义千问)
# ═══════════════════════════════════════════════════════════════════
# QWEN_API_KEY=your-api-key-here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-7b-plus

# ═══════════════════════════════════════════════════════════════════
#  OpenAI
# ═══════════════════════════════════════════════════════════════════
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ═══════════════════════════════════════════════════════════════════
#  Shared LLM params (apply to all providers)
# ═══════════════════════════════════════════════════════════════════
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Agent Behaviour ───────────────────────────────────────────────
AGENT_VERBOSE=true
AGENT_MAX_ITERATIONS=10
AGENT_EARLY_STOPPING=generate

# ── Memory ────────────────────────────────────────────────────────
MEMORY_SESSION_KEY=default

LLM_STREAMING=true

# ── TTS (Text-to-Speech) ─────────────────────────────────────────
# TTS_ENABLED=true
# TTS_VOICE=zh-CN-XiaoxiaoNeural        # 晓晓女声
# zh-CN-YunxiNeural    — 云希：阳光男声
# zh-CN-XiaoyiNeural   — 晓伊：可爱女声
# zh-CN-YunjianNeural  — 云健：成熟男声

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════
#  向量 + RRF 混合检索（可选件，出厂默认关）
# ═══════════════════════════════════════════════════════════════════
# 关（默认）= 纯词法 BM25，与从前逐字节一致。
# 开 = 词法 + 向量双路召回，RRF 融合重排。语料小的时候词法本来就够用，开不开
#      按你的文章规模与 query 类型自己拨。
#
# 向量模型**独立配置**，供应商不进代码 —— 任何 OpenAI 兼容的 embeddings 端点都行。
# 用聚合平台的话，把上面 QWEN_BASE_URL / QWEN_API_KEY 的值复制一份下来：
#   · 想省事就要同一份值（换平台时记得两处一起改）；
#   · 也可以用另一家，互不影响（换对话模型不会顺带打断向量路）。
# ⚠️ 只配了开关没配 key/model ⇒ 向量路不可用，日志里有一条 ERROR，检索自动退回
#    纯词法（不会静默、也不会报错给访客）。
# RAG_HYBRID_ENABLED=1
# EMBEDDING_BASE_URL=https://<你的聚合平台>/v1
# EMBEDDING_API_KEY=your-embedding-api-key-here
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=0                  # 0 = 不向 API 传 dimensions，以返回长度为准
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_TIMEOUT=15
# RRF_K=60                         # RRF 标准常量
