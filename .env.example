# ═══════════════════════════════════════════════════════════════════
#  Saudade Blog Agent — 环境变量样例
#  cp .env.example .env，按注释改。**没写的项一律走 config/settings.py 的默认值。**
#
#  本文件是 `config/settings.py`（pydantic-settings）的镜像：字段名的**全大写即变量名**。
#  下面每一节对应 settings.py 里的一个小节，两边可以对着看。
#
#  ⚠️ 有一条边界必须知道：**`.env` 只喂给 settings.py**。`server.py` 里
#  `AGENT_RECURSION_LIMIT` / `AGENT_MAX_BODY_BYTES` / `AGENT_MAX_CONCURRENT` /
#  `AGENT_MAX_REVIEW` 四个是直接读**进程环境**的常量（`os.environ`），
#  **写在这个文件里一点作用没有**——要配就走 systemd `Environment=` 或启动前 export。
#  详见 README 的《环境变量》一节。
# ═══════════════════════════════════════════════════════════════════

# ── Provider selection ─────────────────────────────────────────────
# 代码里的默认值是 `qwen`；这里给 DeepSeek 的现成路径（注册即用、不绑任何业务空间）。
# 换提供方 = 改这一行 + 打开下面相应那一节。
LLM_PROVIDER=deepseek

# ── DeepSeek ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Qwen (通义千问) ────────────────────────────────────────────────
# ⚠️ `QWEN_BASE_URL` **自己部署必须显式设**：不设就会落到代码里的默认值，而那个值
# 绑定维护者的接入点。端点形状看你的开通方式：
#   · 阿里云百炼（公开端点）：https://dashscope.aliyuncs.com/compatible-mode/v1
#   · 百炼「业务空间」专属端点：https://ws-<你的空间 id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 用聚合平台的话，写它给的那个 OpenAI 兼容地址。
# QWEN_API_KEY=your-api-key-here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.6-flash

# ── OpenAI ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── Shared LLM params（三家用同一份）────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_STREAMING=true
# 单次调用的无数据超时（秒）。不设 = 服务商默认的 600s，偶发无响应会把线程池占满
LLM_TIMEOUT=120
# Qwen 思考模式总开关。图内四个调用都 per-call 关掉了它（思维链有混入正文的风险），
# 这一项只在直连探测时才起作用。
LLM_ENABLE_THINKING=true
# 采样种子。**0 = 不设**，走服务商自己的随机；非零 = 固定种子（调优实验用）。
LLM_SEED=0

# ── Agent 行为 ──────────────────────────────────────────────────────
AGENT_VERBOSE=true

# ── 服务间身份（与 Rust 侧共用）─────────────────────────────────────
# agent 验签 Rust 发来的 `X-Agent-Assertion` 头，据此覆盖请求体里的 user_id。
# **不设 = 起不来那几个需要签 JWT 的能力**（IoT 代签、管理助手代调后台）。
JWT_SECRET=
# 置 1 = 缺失断言的请求直接 401。默认 0 只记 WARNING，便于滚动上线。
AGENT_REQUIRE_ASSERTION=0
# 权限模型的强制开关。默认 0 = shadow（照算决策、只记 trace，不改变行为）。
AUTHZ_ENFORCE=0
# 管理读接口的上游地址（只走回环，别改成公网域名）。
AGENT_ADMIN_BASE=http://127.0.0.1:3000

# ── planner（唯一决策者；接口只有 native tool calls 一条）────────────
# native 档是否开思考。**单独一个开关是刻意的**：它是三个待拍板项之一，
# 要能单独开关才产得出对照数据。
PLANNER_NATIVE_THINKING=true
# native 档预算。别照抄文本档的 400——开思考时思考链先吃额度，arguments 会被截断。
PLANNER_NATIVE_MAX_TOKENS=1200
# 开思考后的超时（秒）。
PLANNER_NATIVE_TIMEOUT=60
# 慢轮告警阈值（秒）。**它与上面那个超时是一对**：只放宽超时、不看这个数，
# 等于把超时问题藏起来。
PLANNER_NATIVE_SLOW_S=30
# 规划温度。0.0 = 决策当分类做。**"温度能治路由抖动"这个归因已被两臂交替的
# A/B 证伪**（见 docs/param-tuning-20261006.md），别再拿它当调参理由。
PLANNER_TEMPERATURE=0.0

# ── 会话级任务状态（跨轮未完成意图）─────────────────────────────────
# 默认 0 = **off**：表先落地、代码先上线、线上行为逐字节不变；打开才登记/注入。
AGENT_TASK_STATE=0
AGENT_TASK_INJECT_MAX=3

# ── IoT 设备服务（ESP32 OLED 等，可选件）────────────────────────────
# **出厂默认关**：关着时 agent 不指路、不介绍这个入口（否则是系统在说假话）。
# 装了这个平台才置 1；**不设变量 = 没装**（别写 =0，虽然也能跑）。
IOT_ENABLED=
DEVICE_SERVICE_URL=http://127.0.0.1:3100

# ── TTS (Text-to-Speech) ───────────────────────────────────────────
# TTS_ENABLED=true
# TTS_VOICE=zh-CN-YunxiNeural    # 云希：阳光男声
#                                 # 晓晓 zh-CN-XiaoxiaoNeural / 晓伊 zh-CN-XiaoyiNeural
#                                 # 云健 zh-CN-YunjianNeural

# ═══════════════════════════════════════════════════════════════════
#  你的博客站点（**自己部署必须改这一项**）
# ═══════════════════════════════════════════════════════════════════
# agent 的每一个只读工具（文章、分类、标签、留言板、站内搜索、知识库）与 RAG 语料
# 都从这一个地址取；导航工具给出的链接也由它反推站点根，所以这一项同时管住"跳转到哪"。
# 不改的话你的 agent 会认真回答**别人博客**里的问题，而且不报错（接口可用、返回是真的，
# 只是不属于你）。末尾必须带 `/api/public`（那是公开接口的挂载点）。
BLOG_API_BASE=https://<你的域名>/api/public

# ── 向量的建图任务 ──────────────────────────────────────────────────
# 建图脚本从哪个公开接口拉语料。**只影响"读文章与读数"，不影响产物归属站点**
# （归属由后台页面把浏览器自己的 origin 传上来）。Rust 不在 3000 才要改这一项。
GRAPH_API_BASE=http://127.0.0.1:3000/api/public

# ═══════════════════════════════════════════════════════════════════
#  向量 + RRF 混合检索（可选件，出厂默认关）
# ═══════════════════════════════════════════════════════════════════
# 关（默认）= 纯词法 BM25，与从前逐字节一致。语料小的时候词法本来就够用，
# 开不开按你的文章规模与 query 类型自己拨。
#
# 向量模型**独立配置、供应商不进代码**：任何 OpenAI 兼容的 embeddings 端点都行。
# 用聚合平台的话，把上面 QWEN_BASE_URL / QWEN_API_KEY 的值复制一份下来即可
# ——**刻意不回落 `active_llm_*`**：跟着对话 provider 走的话，切到一个没有
# embeddings 端点的 provider 就会哑掉，而且哑得没有声音。代价是换平台要改两处。
# ⚠️ 只开了开关没配 key/model ⇒ 向量路不可用（日志一条 ERROR），检索自动退回纯词法。
# RAG_HYBRID_ENABLED=1
# EMBEDDING_BASE_URL=https://<你的聚合平台>/v1
# EMBEDDING_API_KEY=your-embedding-api-key-here
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=0                  # 0 = 不向 API 传 dimensions，以返回长度为准
# EMBEDDING_BATCH_SIZE=10          # 聚合平台单请求上限
# EMBEDDING_TIMEOUT=15             # 查询向量在热路径上，别设大
# EMBEDDING_QUERY_CACHE=256        # 查询向量的内存 LRU（只进内存、不落盘）
# RRF_K=60                         # RRF 标准常量；k 越大对低排名越宽容
# RAG_VECTOR_DIR=data/rag_vectors

# ── 日志与 trace ────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 每轮对话一份 trace JSON（输入摘要 / 节点事件 / 分段耗时 / 最终回复 / 退出原因）。
# **默认值绑定部署环境，自建部署须覆盖**——不覆盖的话会被写到另一个站点那台机器的
# 路径下（通常是权限错或"找不到目录"，但**也可能是静默写到别处**）。
# 20260925 起写进 `<TRACE_DIR>/<YYYYMMDD>/`；枚举与保留期各有单一执行者
# （eval/trace_files.py、eval/trace_retention.py）。
# TRACE_DIR=/your/logs/agent/traces
