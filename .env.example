# ═══════════════════════════════════════════════════════════════════
#  Saudade Blog Agent — 环境变量样例
#  cp .env.example .env，按注释改。**没写的项一律走 config/settings.py 的默认值。**
#
#  本文件是 `config/settings.py`（pydantic-settings）的镜像：字段名的**全大写即变量名**。
#  下面每一节对应 settings.py 里的一个小节，两边可以对着看。
#
#  配置通过 .env 或进程环境加载，进程环境优先。
#  仅进程环境：SAUDADE_IGNORE_ENV_FILE / TRACE_TOOL_RESULT_LIMIT /
#  GOLDEN_ADMIN_UID / GOLDEN_USER_UID。
# ═══════════════════════════════════════════════════════════════════

# ── Provider selection ─────────────────────────────────────────────
# 代码里的默认值是 `qwen`；这里给 DeepSeek 的现成路径（注册即用、不绑任何业务空间）。
# 换提供方 = 改这一行 + 打开下面相应那一节。
LLM_PROVIDER=deepseek

# ── DeepSeek ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Qwen (通义千问) ────────────────────────────────────────────────
# ⚠️ `QWEN_BASE_URL` **自己部署必须显式设**：不设就会落到代码里的默认值，而那个值
# 绑定维护者的接入点。端点形状看你的开通方式：
#   · 阿里云百炼（公开端点）：https://dashscope.aliyuncs.com/compatible-mode/v1
#   · 百炼「业务空间」专属端点：https://ws-<你的空间 id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 用聚合平台的话，写它给的那个 OpenAI 兼容地址。
# QWEN_API_KEY=your-api-key-here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.6-flash

# ── OpenAI ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ── opencode zen ───────────────────────────────────────────────────
# OpenAI 兼容网关。**两条与别家不同的硬约束**（实测，见 `models/llm.py::_provider_headers`）：
#   · 必须带 `x-opencode-session` 头，缺了回 400 `MissingSessionID` —— 由代码补，不用你填；
#   · 免费档（`*-free`）只在 **Go 端点**可用，非 go 的 `/zen/v1` 回 403 `FreeTierError`。
# 端点自带月度额度，用光回 429 `GoUsageLimitError`（换模型即可）。
# OPENCODE_API_KEY=your-api-key-here
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=longcat-2.5-preview-free

# ── Shared LLM params（各家共用同一份）──────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_STREAMING=true
# 单次调用超时（秒）；请求截止时间可进一步缩短它。
LLM_TIMEOUT=120
# SDK 默认思考开关；对话、摘要和回执叙述均按各自调用显式关闭。
LLM_ENABLE_THINKING=true
# 采样种子。**0 = 不设**，走服务商自己的随机；非零 = 固定种子（调优实验用）。
LLM_SEED=0

# ── 对话预算（token，含缓存输入；确认后的新请求单独计账）──────────
# 统计完整消息、工具 schema、调用参数和输出预留。
AGENT_CONTEXT_TOKENS=16384
AGENT_REQUEST_TOKENS=32768
AGENT_MODEL_CALLS=8
AGENT_TOOL_CALLS=8
AGENT_OUTPUT_TOKENS=1536
AGENT_SUMMARY_OUTPUT_TOKENS=512
AGENT_VERBOSE=true
# LLM_MAX_TOKENS / LLM_STREAMING 是直连 SDK 的默认值；对话使用上述输出预算并启用流式。

# ── 服务限额与超时 ─────────────────────────────────────────────────
# 请求体上限（字节；12 MiB），超限 413。
AGENT_MAX_BODY_BYTES=12582912
# 每 worker 的流式并发闸，超限 503（uvicorn --workers 2 ⇒ 全局 2×）。
AGENT_MAX_CONCURRENT=8
# /review 侧任务（审核/摘要）的并发闸——刻意不与上面共用：同步短任务别跟访客对话抢槽。
AGENT_MAX_REVIEW=4
# 流式空闲超时（秒）：与前端 120s 对齐，超过它没有输出帧就终止流。
AGENT_STREAM_IDLE_TIMEOUT=120
# 流式总时长硬上限（秒）：帧流动会重置空闲超时，靠它兜底保证流必会终止。
AGENT_STREAM_TOTAL_TIMEOUT=300

# ── 服务间身份（与 Rust 侧共用）─────────────────────────────────────
# agent 验签 Rust 发来的 `X-Agent-Assertion` 头，据此覆盖请求体里的 user_id。
# **不设 = 起不来那几个需要签 JWT 的能力**（IoT 代签、管理助手代调后台）。
JWT_SECRET=
# 置 1 = 缺失断言/验签失败的请求直接 401。**出厂默认就是 1**（20261019 安全审计
# SAU-005）。置 0 是回退到"信任请求体里的 user_id"——那条路径上的身份没有角色、
# 也没有任何一条 scope，工具一个都调不动（agent/authz.py::must_enforce），
# 只在排障时短暂使用，不要留在生产配置里。
AGENT_REQUIRE_ASSERTION=1
# 附加权限策略；原生工具始终校验调用者身份和 scope。
AUTHZ_ENFORCE=0
# 管理读接口的上游地址（只走回环，别改成公网域名）。
AGENT_ADMIN_BASE=http://127.0.0.1:3000

# 宿主传入任务上下文的条数上限；不会驱动旧规划器或任务执行器。
AGENT_TASK_INJECT_MAX=3

# ── IoT 设备服务（ESP32 OLED 等，可选件）────────────────────────────
# **出厂默认关**：关着时 agent 不指路、不介绍这个入口（否则是系统在说假话）。
# 装了这个平台才置 1；**不设变量 = 没装**（别写 =0，虽然也能跑）。
# ⚠️ 下面这一行**必须保持注释**。「不设变量」的写法是**整行注掉**，不是留一个空值：
#    pydantic-settings 没有 env_ignore_empty，空串给 `iot_enabled: bool` ⇒ 导入期
#    ValidationError（`config/settings.py` 末尾是模块级 `settings = Settings()`）⇒
#    agent **起不来**、systemd 无限重启。20261007 实测：把这行留成 `IOT_ENABLED=` 时
#    `FAIL: ValidationError … iot_enabled … input_value=''`。全新部署必中（`deploy/install.sh`
#    在 agent 没有 .env 时会**逐字**复制本文件），而本机装了 IoT、.env 里有 =1，所以从没暴露。
# IOT_ENABLED=1
DEVICE_SERVICE_URL=http://127.0.0.1:3100

# ── TTS (Text-to-Speech) ───────────────────────────────────────────
# TTS_ENABLED=true
# TTS_VOICE=zh-CN-YunxiNeural    # 云希：阳光男声
#                                 # 晓晓 zh-CN-XiaoxiaoNeural / 晓伊 zh-CN-XiaoyiNeural
#                                 # 云健 zh-CN-YunjianNeural

# ═══════════════════════════════════════════════════════════════════
#  你的博客站点（**自己部署必须改这一项**）
# ═══════════════════════════════════════════════════════════════════
# agent 的每一个只读工具（文章、分类、标签、留言板、站内搜索、知识库）与 RAG 语料
# 都从这一个地址取；导航工具给出的链接也由它反推站点根，所以这一项同时管住"跳转到哪"。
# 不改的话你的 agent 会认真回答**别人博客**里的问题，而且不报错（接口可用、返回是真的，
# 只是不属于你）。末尾必须带 `/api/public`（那是公开接口的挂载点）。
BLOG_API_BASE=https://<你的域名>/api/public

# ── 向量的建图任务 ──────────────────────────────────────────────────
# 建图脚本从哪个公开接口拉语料。**只影响"读文章与读数"，不影响产物归属站点**
# （归属由后台页面把浏览器自己的 origin 传上来）。Rust 不在 3000 才要改这一项。
# 建图**还需要一份可用的 embedding 配置**（就是下面那一组）：配了 `EMBEDDING_*` 用它，
# 没配则回落 `QWEN_*` + `qwen3.7-text-embedding`；两处都空会当场停下，并说清缺的是哪一格。
GRAPH_API_BASE=http://127.0.0.1:3000/api/public

# ═══════════════════════════════════════════════════════════════════
#  向量（RAG 混合检索 + 首页那件图谱，共用这一组配置）
# ═══════════════════════════════════════════════════════════════════
# 混合检索：关（默认）= 纯词法 BM25，与从前逐字节一致。语料小的时候词法本来就够用，
# 开不开按你的文章规模与 query 类型自己拨。
#
# ⚠️ **这一组不只管检索**：`RAG_HYBRID_ENABLED` 关着的时候它照样是首页「文章向量空间
# 图谱」的配置（20261007 起图谱的建图与检索共用这一组）。所以**改了这一组要重建一次
# 图谱**（后台「站点设置 → 向量图谱」）：旧图是另一片空间建的，检索侧会以
# `space_mismatch` 明着降级（日志一条 WARNING + 前端退回本地关键词匹配）。
#
# 向量模型**独立配置、供应商不进代码**：任何 OpenAI 兼容的 embeddings 端点都行。
# 用聚合平台的话，把上面 QWEN_BASE_URL / QWEN_API_KEY 的值复制一份下来即可
# ——**刻意不回落 `active_llm_*`**：跟着对话 provider 走的话，切到一个没有
# embeddings 端点的 provider 就会哑掉，而且哑得没有声音。两处消费面共用这一处，
# 不必再改两遍。
# ⚠️ 只开了开关没配 key/model ⇒ 向量路不可用（日志一条 ERROR），检索自动退回纯词法；
# 图谱那一侧则回落 `QWEN_*`（上面那组），通路本身不变；但回落档的**模型名 20261016
# 换过一代**（`text-embedding-v4` → `qwen3.7-text-embedding`），所以按旧回落档建过的
# 图/缓存要重建一次（检索侧以 `space_mismatch` 明着降级，不是静默错）。
# 占位串统一写 `your-api-key-here`（**只有这一个串被认作"没配"**，见
# `Settings.embedding_configured` 与 `rag/embed_space.py`）。另起一个名字的占位
# 会被当成真 key：留着一份能用的 `QWEN_*` 时，图谱反而会挑中这个假的。
# RAG_HYBRID_ENABLED=1
# EMBEDDING_BASE_URL=https://<你的聚合平台>/v1
# EMBEDDING_API_KEY=your-api-key-here
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIM=0                  # 0 = 不向 API 传 dimensions，以返回长度为准
# EMBEDDING_BATCH_SIZE=10          # 聚合平台单请求上限
# EMBEDDING_TIMEOUT=15             # 查询向量在热路径上，别设大
# EMBEDDING_PROFILE=               # 可选 RAG 输入预算；见 docs/embedding-inputs.md
# EMBEDDING_QUERY_CACHE=256        # 查询向量的内存 LRU（只进内存、不落盘）
# RRF_K=60                         # RRF 标准常量；k 越大对低排名越宽容
# RAG_VECTOR_DIR=data/rag_vectors

# ── 日志与 trace ────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 每轮对话一份 trace JSON（输入摘要 / 节点事件 / 分段耗时 / 最终回复 / 退出原因）。
# **默认值绑定部署环境，自建部署须覆盖**——不覆盖的话会被写到另一个站点那台机器的
# 路径下（通常是权限错或"找不到目录"，但**也可能是静默写到别处**）。
# 20260925 起写进 `<TRACE_DIR>/<YYYYMMDD>/`；枚举与保留期各有单一执行者
# （utils/trace_files.py、eval/trace_retention.py）。
# TRACE_DIR=/your/logs/agent/traces
# 写操作幂等账（agent 自持的 SQLite，agent/idem.py）。它的闸是"这一轮挂没挂
# checkpointer"：**不配 CHECKPOINT_DSN 时这个文件不会被创建**（图是裸的 ⇒ 恒直通），
# 配了才开始写。所以**保留期必须与 checkpoint store 一起设计**
# （eval/retention_manifest.py 里登记的是 open/未接管，理由在那儿）。
# IDEM_DB=/your/logs/agent/idem.sqlite3

# ── checkpoint 存储（ADR-0011 的接线点）──────────────────────────────
# 图自持上下文要用的 saver 后端（agent/checkpoint.py::build_checkpointer 读这一格）。
# **缺省空 = 从前的行为**：空 ⇒ 图仍是裸的 g.compile()，生产逐字节不变。
# 20261018 起接线已落地（"三处一起动"，共用 `server._graph_holds_context()` 一个判据：
# 历史注入套闸门 + thread_id 改会话坐标 + `create_agent(checkpointer=…)`）⇒
# **填上这一行就真开**。建表由 `PostgresSaver.setup()` 启动时幂等做（包在咨询锁里，
# 4 个 worker 同时起安全）。详见 ADR-0011 与 config/settings.py 的 checkpoint_dsn 一段。
# 只认 postgresql:// / postgres:// / sqlite://；**故意不认内存档**（4 个 worker 下
# 每 worker 各记各的，且不报错）。认不出的 scheme、依赖没装，都是响亮报错、不回落。
# ⚠️ **它指的必须是业务库之外的独立库**：saver 会在那个库里建 4 张本 agent 自持的表
# （checkpoints / checkpoint_writes / checkpoint_blobs + 幂等账 agent_write_idem），
# 而建表走 PostgresSaver.setup()、**没有编号迁移**——指进业务库就等于在业务库上开一条
# 没人编号、不在 CI 里的 DDL 通道，且因为表名不重名而**不报错**。
# 理由、可读出口与"旧数据不迁"见 agent/checkpoint.py 头注《DSN 指向哪个库》。
# 依赖已在 pyproject.toml 里声明（langgraph-checkpoint-postgres / psycopg[binary]）。
# CHECKPOINT_DSN=postgresql://user:password@127.0.0.1:5432/your-checkpoint-db
# 「指错库」的硬闸：填业务库的**库名**，CHECKPOINT_DSN 指到它 ⇒ 启动期当场抛。
# **缺省空 = 不拦**（库名是运维坐标，不写进本仓）。见 agent/checkpoint.py 的 db_name。
# CHECKPOINT_FORBID_DB=
