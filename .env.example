# Copy to .env; process environment takes precedence. Defaults: config/settings.py.
# Process-only: SAUDADE_IGNORE_ENV_FILE, TRACE_TOOL_RESULT_LIMIT, GOLDEN_ADMIN_UID, GOLDEN_USER_UID.
# Never commit credentials. Provider endpoints must match the key's plan/region.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.6-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_STREAMING=true
LLM_ENABLE_THINKING=true
LLM_SEED=0
AGENT_REASONING_EFFORT=low

# Verified host identity and actual public site origin.
AGENT_ASSERTION_SECRET=
AGENT_CONFIRM_SECRET=
# Host-issued capabilities are stored privately when scheduling is enabled.
DELEGATION_DIR=data/delegations
AGENT_REQUIRE_ASSERTION=1
AGENT_ADMIN_BASE=http://127.0.0.1:3000
BLOG_API_BASE=http://127.0.0.1:3000/api/public
GRAPH_API_BASE=http://127.0.0.1:3000/api/public

# Durable conversations and approvals require a separate Agent PostgreSQL database.
CHECKPOINT_DSN=
CHECKPOINT_FORBID_DB=

# Match the configured endpoint's real context limit. These are upper bounds.
AGENT_CONTEXT_TOKENS=128000
AGENT_INPUT_TOKENS=128000
AGENT_TASK_TOKENS=1000000
AGENT_TASK_SECONDS=300
AGENT_MODEL_CALLS=12
AGENT_TOOL_CALLS=16
AGENT_OUTPUT_TOKENS=4096
AGENT_TOOL_RESULT_TOKENS=12000
AGENT_SUMMARY_OUTPUT_TOKENS=4096
AGENT_COMPACTION_TRIGGER=0.8
AGENT_COMPACTION_TARGET=0.4
AGENT_VERBOSE=true

# Limits are per process; idle pages do not reserve running-task permits.
AGENT_MAX_BODY_BYTES=12582912
AGENT_MAX_CONCURRENT=8
AGENT_MAX_REVIEW=4
AGENT_STREAM_IDLE_TIMEOUT=120
AGENT_STREAM_TOTAL_TIMEOUT=300

# Optional embedding service. Local token budget profiles: docs/embedding-inputs.md.
RAG_HYBRID_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=0
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=15
EMBEDDING_PROFILE=
EMBEDDING_QUERY_CACHE=256
RRF_K=60
RAG_VECTOR_DIR=data/rag_vectors

# Optional background scheduler needs its own DBOS worker.
SCHEDULING_ENABLED=false
SCHEDULING_DSN=

# Optional demo integrations.
IOT_ENABLED=false
DEVICE_SERVICE_URL=http://127.0.0.1:3000/api/device-gateway
TTS_ENABLED=false
TTS_VOICE=zh-CN-XiaoyiNeural

LOG_LEVEL=INFO
TRACE_DIR=data/traces
BLOG_ROOT=
