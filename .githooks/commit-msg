#!/usr/bin/env bash
# Shared validation for local commits, mainline commits and pull request titles.
set -euo pipefail

message_file="${1:-}"
mode="${2:-commit}"
if [[ ! -f "$message_file" || ( "$mode" != commit && "$mode" != --title ) ]]; then
  echo "用法：commit-msg MESSAGE_FILE [--title]" >&2
  exit 2
fi
command -v python3 >/dev/null || { echo "提交校验需要 Python 3。" >&2; exit 2; }
message="$(sed -e 's/\r$//' -e '/^#/d' "$message_file")"
subject="${message%%$'\n'*}"
fail() {
  printf '提交说明格式错误：%s\n标题：%s\n规范见 CONTRIBUTING.md。\n' "$1" "$subject" >&2
  exit 1
}
if [[ "$mode" == --title ]]; then
  [[ -n "$message" && "$message" != *$'\n'* && "$message" != *$'\r'* ]] \
    || fail "PR 标题应为非空的单行文本"
else
  [[ -n "$message" ]] || exit 0
  case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
fi
length="$(printf '%s' "$subject" | python3 -c 'import sys; print(len(sys.stdin.read()))')"
[[ "$length" -le 60 ]] || fail "标题超过 60 个字符"
[[ "$subject" == *': '* ]] || fail "使用 type(scope): 描述，冒号后留一个空格"
prefix="${subject%%:*}"
type="${prefix%%(*}"
type="${type%!}"
case "$type" in
  feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert) ;;
  *) fail "未知的提交类型：$type" ;;
esac
[[ "$prefix" =~ ^[a-z]+(\([a-z0-9][a-z0-9._/-]*\))?!?$ ]] \
  || fail "类型与 scope 使用小写；不兼容变更可在冒号前加 !"
description="${subject#*: }"
[[ "$description" =~ [^[:space:]] ]] || fail "标题缺少变更描述"
second="$(printf '%s\n' "$message" | sed -n '2p')"
[[ -z "$second" ]] || fail "标题与正文之间应空一行"
