#!/usr/bin/env bash
# Validate CONTRIBUTING.md section 3; used by both local Git and CI.
set -euo pipefail

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg：需要提交信息文件的路径（git 会自己传；CI 里传临时文件）" >&2
  exit 2
fi

# 剥掉 `#` 注释行（git 的提交模板、`commit --verbose` 都会往消息文件里塞），
# 命令替换顺带吃掉尾部空行 ⇒ 后面按行处理不必再兜尾。
MSG="$(sed '/^#/d' "$MSG_FILE")"
[ -n "$MSG" ] || exit 0          # 全空：空提交信息由 git 自己拦，不在这里重复报错

SUBJECT="${MSG%%$'\n'*}"

case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# 字符数而不是字节数：`LC_ALL=C` 时 bash 的 ${#v} 数的是字节（中文一个字变 3 字节，
# 20 字的正常摘要会被误判成 60+）。python3 不受 locale 影响，本仓本来就要求 Python 3.12。
# 真没有 python3 才退回 ${#v}，并把这件事说出来。
char_len() {
  if command -v python3 >/dev/null 2>&1; then
    # 走 stdin 而不是 argv：首行以 `-` 打头时 `python3 -c … "$1"` 会把它当选项解析
    printf '%s' "$1" | python3 -c 'import sys; print(len(sys.stdin.read()))'
  else
    echo "commit-msg：没找到 python3，按当前 locale 数字节（UTF-8 之外的 locale 会误判）" >&2
    printf '%s' "${#1}"
  fi
}

N="$(char_len "$SUBJECT")"

fail() {
  echo "" >&2
  echo "✗ 提交信息不合规：$1" >&2
  echo "  首行：$SUBJECT" >&2
  echo "  规范：CONTRIBUTING.md 的《3. 提交约定》一节（首行 ≤60 字符 + type[(scope)][!]: 描述 + 空行）" >&2
  exit 1
}

[ "$N" -le 60 ] || fail "首行 $N 字符，超过 60"

# Conventional Commits 前缀；scope 与破坏性变更标记可选。
PREFIX="${SUBJECT%%:*}"
TYPE="${PREFIX%%(*}"
TYPE="${TYPE%!}"
if [ "$PREFIX" = "$SUBJECT" ]; then
  fail "首行没有 'type: ' 前缀"
fi
case "$TYPE" in
  feat|fix|refactor|docs|test|chore|perf|ci) ;;
  *) fail "type『$TYPE』不在白名单（feat/fix/refactor/docs/test/chore/perf/ci）" ;;
esac
[[ "$PREFIX" =~ ^[a-z]+(\([a-z0-9][a-z0-9._/-]*\))?!?$ ]] \
  || fail "前缀应为 type[(scope)][!]，scope 须为小写模块名"
REST="${SUBJECT#*: }"
[ "$REST" != "$SUBJECT" ] || fail "冒号后要有一个空格（写成 '$TYPE: 描述'）"
[[ "$REST" =~ [^[:space:]] ]] || fail "冒号后面没有描述"

# 有正文时，首行与正文之间必须空一行。只看"第二行在不在"：只有一行的提交信息是合法的。
SECOND="$(printf '%s\n' "$MSG" | sed -n '2p')"
if [ "$(printf '%s\n' "$MSG" | wc -l)" -gt 1 ] && [ -n "$SECOND" ]; then
  fail "首行与正文之间要空一行（第二行现在有字）"
fi

if printf '%s\n' "$MSG" | grep -qi '^co-authored-by:'; then
  fail "不许加 Co-Authored-By / 共同作者署名"
fi

exit 0
